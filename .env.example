# Copiar a .env en la raíz del repo (docker-compose.yml y el backend lo leen)
# Infraestructura compartida (ya en docker-compose.yml)
POSTGRES_USER=si16_user
POSTGRES_PASSWORD=si16_password
POSTGRES_DB=si16_db

# Backend
DATABASE_URL=postgres://si16_user:si16_password@localhost:5432/si16_db?sslmode=disable
REDIS_ADDR=localhost:6379
JWT_SECRET=cambiar-en-produccion-32-bytes-min
SERVER_ADDR=:8080

# Tarificación HU-03: euros por minuto de excedente (los 30 primeros minutos son 0,00 EUR)
TARIFA_MINUTO=0.20
