# Copiar a .env y ajustar. Lo leen docker compose (POSTGRES_*) y el backend.

# --- docker compose (PostgreSQL) ---
POSTGRES_USER=si16_user
POSTGRES_PASSWORD=si16_password
POSTGRES_DB=si16_db

# --- backend ---
DATABASE_URL=postgres://si16_user:si16_password@localhost:5432/si16_db?sslmode=disable
REDIS_ADDR=localhost:6379
JWT_SECRET=cambia-esto-por-un-secreto-largo
# Euros por minuto de excedente sobre los 30 min gratuitos (R8)
TARIFA_MINUTO=0.20
PUERTO=8080

# --- tests de integración (BD y Redis aislados de los de desarrollo) ---
# La BD de tests se crea sola si no existe; Redis usa la base lógica 15.
TEST_DATABASE_URL=postgres://si16_user:si16_password@localhost:5432/si16_test?sslmode=disable
TEST_REDIS_DB=15
